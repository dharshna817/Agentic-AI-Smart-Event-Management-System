# Frontend environment variables example
# Do NOT include secrets here. Use build-time env vars in your hosting provider.

VITE_API_BASE_URL=https://api.example.com
VITE_SOCKET_URL=wss://realtime.example.com
VITE_GOOGLE_ANALYTICS_ID=
# Frontend Production Environment Variables Example
# Copy to .env or .env.production and fill in actual production URLs

# Base Backend API URL
VITE_API_BASE_URL=http://localhost:5002

# Real-Time Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5002

# Application Environment Mode
VITE_APP_ENV=production
