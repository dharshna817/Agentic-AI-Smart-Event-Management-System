# Backend Production Environment Variables Example
# Copy to .env or .env.production and fill in actual values for production deployment

NODE_ENV=production
PORT=5002

# Database Configuration
DATABASE_URL=./registrations.json

# JWT Secret Key for RBAC Authentication
JWT_SECRET=your_production_jwt_secret_key_change_in_prod

# Allowed CORS Origins
FRONTEND_URL=http://localhost:3000

# Backend Base API URL
BACKEND_URL=http://localhost:5002

# AI Services API Configuration
AI_API_KEY=your_secure_ai_api_key_placeholder
AI_MODEL_ENDPOINT=https://api.openai.com/v1

# Email Service Configuration (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# Socket.IO Config
SOCKET_CORS_ORIGIN=http://localhost:3000
