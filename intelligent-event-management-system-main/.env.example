# Root environment variables example for deployment orchestration

NODE_ENV=production
PORT=5002

# Database
DATABASE_URL=postgres://user:password@db-host:5432/eventai

# JWT
JWT_SECRET=

# AI
AI_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Frontend/Backend URLs
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
